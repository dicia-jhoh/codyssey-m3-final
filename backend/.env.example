# 이 파일을 .env 로 복사해 값을 넣는다. .env 는 커밋하지 않는다(.gitignore).
# 비워 두면 샘플 모드 — 가짜 고지서 해독 결과를 돌려준다.
# Anthropic 키면 Claude, Google AI Studio 키(AIza…·AQ.…)면 Gemini(gemini-flash-lite-latest)로 보낸다.
LLM_API_KEY=
# n8n 기한 알림 Webhook 주소(automation/n8n/README.md 참고). 비워 두면 알림 호출을 안 한다.
N8N_WEBHOOK_URL=
# 우리가 제공할 법조의 문구가 실제 법령정보센터에 공개돼 있는 성문법과 일치하는지 법제처 서버로 확인함. 법제처 Open API 키(OC). 팀 공용 parapuda 를 그대로 쓴다 — 따로 신청할 필요 없다(프로젝트 끝나면 폐기).
LAW_OC=parapuda
