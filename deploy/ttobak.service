# 또박또박 서비스(화면 + API) — OCI mc-osaka-1, 포트 8037(M3 자리) — 홈페이지·서비스 화면·API 를 한 포트로
# 설치: sudo cp deploy/ttobak.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now ttobak
[Unit]
Description=ttobak (또박또박 — AI 고지서 해독기, FastAPI + web)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/codyssey-m3-final/data
WorkingDirectory=/home/ubuntu/codyssey-m3-final/backend
# LLM_API_KEY 는 이 파일(서버에만 있음)에 둔다. 없으면 샘플 모드
EnvironmentFile=-/home/ubuntu/codyssey-m3-final/backend/.env
ExecStart=/home/ubuntu/codyssey-m3-final/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8037
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
